# Región AWS (California = us-west-1)
REUX_AWS_REGION=us-west-1

# Perfil de AWS CLI a usar (p. ej. creado con: aws login --profile reux)
AWS_PROFILE=reux

# Bucket creado por infra/template.yaml (salida "Bucket" del stack)
REUX_BUCKET=reu-x-<ID_DE_CUENTA>-us-west-1

# Modelo para redactar la minuta:
#   bedrock   -> Claude en Amazon Bedrock (requiere acceso al modelo en la cuenta)
#   anthropic -> API de Anthropic directa (requiere ANTHROPIC_API_KEY)
#   demo      -> respuestas fijas de ejemplo para probar la interfaz
REUX_LLM=bedrock
# Modelo de Bedrock habilitado en la cuenta (por defecto us.anthropic.claude-opus-5-5)
REUX_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# REUX_MODEL=claude-opus-5-5
